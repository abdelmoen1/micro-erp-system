# Keep secrets, local state and build output out of the image.
.env
.env.*
!.env.example
vendor
node_modules
public/build
public/hot
public/storage
storage/*.key
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
database/*.sqlite
tests
.phpunit.cache
.phpunit.result.cache
phpunit*.xml
postman
Dockerfile
.dockerignore
