# Test-only environment. Loaded instead of .env whenever APP_ENV=testing,
# so tests never read the developer's real database credentials.
# Contains no secrets: the key below is a throwaway used only by the test suite.
APP_NAME="Hisbah Smart Shop"
APP_ENV=testing
APP_KEY=base64:m/gh11YSRf1eza6+MhUf0N5NIVrD2uZcmUNIKOkDrv4=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Overridden per suite by phpunit.xml (sqlite) and phpunit.mysql.xml (mysql).
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
