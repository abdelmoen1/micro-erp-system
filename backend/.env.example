APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Subscriptions (config/hisbah.php, docs/release-readiness/SUBSCRIPTION_ARCHITECTURE.md).
# One free trial per owner number; `expiring` = this many days or fewer left.
HISBAH_TRIAL_DAYS=14
HISBAH_EXPIRING_DAYS=3
# Owner-requested store closure: days before the store and its data are deleted.
HISBAH_DELETION_GRACE_DAYS=14
# WEBSITE only (international digits, e.g. 970599000000). The Android app never shows these.
SUPPORT_WHATSAPP=
# [OWNER_INPUT_REQUIRED] WhatsApp Business number for manual subscription requests.
WHATSAPP_BUSINESS_NUMBER=

# Browser origins allowed to call the API cross-origin (config/cors.php).
# CORS_ALLOWED_ORIGINS=https://hisbah-web.vercel.app

# Online payment providers (config/payments.php, PAYMENT_INTEGRATION_GUIDE.md). Disabled: no
# provider adapter exists until the owner supplies official documentation and sandbox credentials.
PAYMENT_CURRENCIES=ILS,USD,JOD
PALPAY_ENABLED=false
JAWWAL_PAY_ENABLED=false
BOP_GATEWAY_ENABLED=false
