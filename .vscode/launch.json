{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Phone-sized Chrome window on the right, against the local API task.
            "name": "mobile (Chrome phone)",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "preLaunchTask": "API: local (SQLite)",
            "args": [
                "--dart-define-from-file=env/dev.json",
                "--web-port=5555",
                "--web-browser-flag=--window-size=412,860",
                "--web-browser-flag=--window-position=1110,0"
            ]
        },
        {
            // Same phone-sized window against the LIVE API (real store accounts; writes are real data).
            "name": "mobile (Chrome phone, live API)",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": [
                "--dart-define=API_BASE_URL=https://hisbah-api-alur.onrender.com/api/v1",
                "--web-port=5556",
                "--web-browser-flag=--window-size=412,860",
                "--web-browser-flag=--window-position=1110,0"
            ]
        },
        {
            // Android emulator (reaches the API at 10.0.2.2:8000 by default).
            "name": "mobile",
            "preLaunchTask": "API: local (SQLite)",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "mobile (profile mode)",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "mobile (release mode)",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": ".widget_preview",
            "cwd": "mobile\\.widget_preview",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": ".widget_preview (profile mode)",
            "cwd": "mobile\\.widget_preview",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": ".widget_preview (release mode)",
            "cwd": "mobile\\.widget_preview",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}