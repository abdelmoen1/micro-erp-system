# Base URL of the Laravel API, version 1. Leave unset in development to use the
# Vite proxy ("/api/v1" -> VITE_DEV_API_TARGET). Set it for deployed builds.
# VITE_API_URL=https://api.example.com/api/v1

# Laravel server that the dev proxy forwards /api requests to.
# VITE_DEV_API_TARGET=http://127.0.0.1:8000

